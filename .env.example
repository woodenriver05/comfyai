# ComfyUI Memory RAG v1 - Environment Variables
# 복사해서 .env로 저장 후 값 수정

# === Database ===
POSTGRES_USER=raguser
POSTGRES_PASSWORD=ragpass
POSTGRES_DB=comfyui_rag
DATABASE_URL=postgresql://raguser:ragpass@localhost:5432/comfyui_rag

# === API Server ===
API_HOST=0.0.0.0
API_PORT=7001

# === ComfyUI PC Connection ===
COMFYUI_API_URL=http://192.168.1.100:8188
# PC의 실제 IP로 변경 필요

# === Embedding ===
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384

# === Search ===
SEARCH_TOP_K=10
